{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Library Interface Schema",
  "description": "Schema for defining Library Interfaces",
  "type": "object",
  "required": ["description", "category", "version", "components"],
  "properties": {
    "description": {
      "type": "string",
      "description": "Description of the interface's purpose"
    },
    "category": {
      "type": "string",
      "description": "Domain category (marketing, documentation, etc.)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the interface"
    },
    "components": {
      "type": "object",
      "description": "Component definitions",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "category", "presets"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of the component's purpose"
          },
          "category": {
            "type": "string",
            "description": "Component category within the interface"
          },
          "presets": {
            "type": "object",
            "description": "Preset variations of the component",
            "additionalProperties": {
              "type": "string",
              "description": "Description of the preset's purpose"
            },
            "minProperties": 1
          }
        },
        "additionalProperties": false
}
      },
      "minProperties": 1
    }
  },
  "additionalProperties": false